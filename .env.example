# ========== Database Configuration ==========
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vidpalai
POSTGRES_USER=vidpalai
POSTGRES_PASSWORD=vidpalai_secure_2025

# ========== Google Cloud / Gemini ==========
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-key.json
GCS_BUCKET_NAME=

# Or use API key instead (if not using Vertex AI)
# GOOGLE_API_KEY=your-api-key
SETUP_TYPE=podcast_3p
CAMERA_SETUP={"cam_a": "Person A (woman, closeup)", "cam_b": "Person B (man, closeup)", "cam_wide": "All three participants"}
# ========== Hugging Face (for speaker diarization) ==========
HUGGINGFACE_TOKEN=

# ========== Processing Configuration ==========
USE_GPU=false
ENABLE_CACHING=true
ENABLE_VLM_PROCESSING=false
REFINE_WITH_LLM=false
EXPECTED_SPEAKERS=3

# ========== RAG Configuration (Updated for Gemini) ==========
USE_RAG=true
RAG_CHUNK_SIZE=30
RAG_TOP_K=3

# Gemini Embedding Settings
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768  # Options: 384, 768, or 3072

# ========== EDL Rules ==========
MIN_SHOT_DURATION=2.0
WIDE_OPENING_DURATION=3.0
RAPID_WINDOW_SECONDS=8.0
RAPID_CHANGES_THRESHOLD=3

# ========== Paths ==========
INPUT_DIR=input
OUTPUT_DIR=output
CACHE_DIR=.cache
WINDOWS_PROJECT_ROOT=
SPEAKER_IDENTIFICATION_PROVIDER=gcs
